citHeader("To cite ThermoPheno in publications use:")

version <- as.character(meta$Version)
doi <- unname(c("0.1.0" = "10.5281/zenodo.23619167",
                "0.1.1" = "10.5281/zenodo.24441786",
                "0.2.0" = "10.5281/zenodo.24442888")[version])
archive <- "https://doi.org/10.5281/zenodo.23619166"

bibentry(
  bibtype = "Manual",
  title = "ThermoPheno: Thermal-Time-Based Crop Phenology Simulation",
  author = person("Mohammad Reza", "Eini"),
  year = "2026",
  note = paste("R package version", version),
  doi = if (!is.na(doi)) doi else NULL,
  url = if (!is.na(doi)) paste0("https://doi.org/", doi) else archive,
  textVersion = paste(
    "Eini, M. R. (2026). ThermoPheno: Thermal-Time-Based Crop Phenology Simulation",
    paste0("(Version ", version, ") [Computer software]."),
    if (!is.na(doi)) paste0("Zenodo. https://doi.org/", doi) else archive
  )
)

citFooter(paste("Archive of all versions:", archive))
